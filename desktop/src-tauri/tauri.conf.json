{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccuChek Local",
  "version": "0.1.0",
  "identifier": "local.accuchek.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'" },
    "windows": [{ "title": "AccuChek Local", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 620, "resizable": true }]
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": [] }
}
